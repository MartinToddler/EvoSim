{
  "name": "eon-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "pnpm --filter @eon/web build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "headless": "tsx scripts/headless.ts",
    "benchmark:engine": "tsx scripts/benchmark.ts",
    "soak:long": "tsx scripts/soak.ts",
    "equivalence": "tsx scripts/workerEquivalence.ts",
    "sweep": "tsx scripts/sweep.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eon/engine": "workspace:*",
    "@eon/protocol": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
